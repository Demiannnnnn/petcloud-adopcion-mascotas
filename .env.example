# ============================================
# PetCloud - Variables de Entorno de Ejemplo
# ============================================
# Copia este archivo como .env para configurar tu entorno local o de producción.
# NUNCA guardes ni versiones contraseñas ni tokens reales en Git.

# Base de datos (MySQL para prod, H2 por defecto en dev)
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_URL=jdbc:mysql://localhost:3306/petcloud_users?useSSL=false&serverTimezone=UTC

# Mercado Pago (donations-service)
# Access Token obtenido desde el panel de desarrolladores de Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=CHANGE_ME

# Frontend URL (usada para redirecciones de retorno de pagos y CORS)
APP_FRONTEND_URL=https://localhost

# URLs de APIs internas (Docker Compose / Microservicios)
PETS_API_BASE=http://pets-service:8082
USERS_API_BASE=http://users-service:8081
